# BuyWise — Zero-Cost Forever Deployment on Oracle Cloud Always Free
# Copy to .env and fill the REQUIRED values. Never commit .env.
# Ollama is self-hosted and free (open source) — running it on the VM costs $0.
# No paid provider keys are required. Leave TAVILY_API_KEY and SERPAPI_API_KEY
# empty for $0 forever; providers return UNAVAILABLE and the system continues.

# --- Postgres / n8n core (REQUIRED — generate these yourself) ---
POSTGRES_DB=buywise
POSTGRES_USER=buywise
POSTGRES_PASSWORD=change-me-to-a-long-random-secret-at-least-32-chars
POSTGRES_PORT=5432
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key-at-least-32-chars
N8N_PORT=5678
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# --- Web server (optional override) ---
PORT=8080

# --- Ollama (SELF-HOSTED, FREE — $0 to run on the VM) ---
# Ollama is open-source software you run yourself. It is NOT a paid cloud API.
# It needs ~2 GB RAM for llama3.2:3b, which fits in Oracle's free tier (12 GB RAM).
# Set LLM_AVAILABLE=false to disable LLM entirely; web server deterministic
# pipeline still works, but n8n product research agent needs Ollama.
LLM_AVAILABLE=true
LLM_PROVIDER=ollama
LLM_API_URL=http://ollama:11434
LLM_API_KEY=
LLM_MODEL=llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_PORT=11434
OLLAMA_HOST=0.0.0.0:11434

# --- Provider keys (ALL OPTIONAL — leave empty for $0 forever) ---
# Missing keys → provider returns UNAVAILABLE → deterministic fallback continues.
# SerpAPI: https://serpapi.com (free 250 searches/mo, then PAID — do NOT add if you want $0 forever)
# Tavily:  https://app.tavily.com (free 1000 credits/mo, then PAID — do NOT add if you want $0 forever)
TAVILY_API_KEY=
SERPAPI_API_KEY=
EBAY_ENABLED=false
EBAY_APP_ID=
EBAY_CERT_ID=
YELP_API_KEY=

# --- Procurement policy ---
NEGOTIATION_SEND_MODE=DRAFT_ONLY
# DRAFT_ONLY (default: proposals can never be sent — zero risk of accidental vendor contact)
