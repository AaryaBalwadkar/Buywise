{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "buywise/decision-output.schema.json",
  "title": "DecisionOutput",
  "type": "object",
  "required": ["procurement_id", "decision", "decision_reason", "blocking_reasons"],
  "properties": {
    "decision_id": { "type": "string" },
    "procurement_id": { "type": "string", "format": "uuid" },
    "product_id": { "type": ["string", "null"], "description": "Chosen candidate, or rank-1 for INSUFFICIENT_DATA, or null with no candidates." },
    "comparison_id": { "type": ["string", "null"] },
    "decision": { "type": "string", "enum": ["PROCEED", "NEGOTIATE", "INSUFFICIENT_DATA"] },
    "decision_reason": { "type": "string", "minLength": 1 },
    "blocking_reasons": { "type": "array", "items": { "type": "string" } },
    "criteria_used": { "type": "array", "items": { "type": "string" } },
    "criteria_missing": { "type": "array", "items": { "type": "string" } },
    "evidence_urls": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
