{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "buywise/approval-package.schema.json",
  "title": "ApprovalPackage",
  "type": "object",
  "required": ["procurement_id", "procurement_request", "status"],
  "properties": {
    "approval_id": { "type": "string" },
    "procurement_id": { "type": "string", "format": "uuid" },
    "procurement_request": { "type": "object" },
    "selected_product": { "type": ["object", "string"], "description": "Object when selected, else 'unavailable'." },
    "selected_vendor": { "type": ["object", "string"] },
    "original_offer": { "type": ["object", "string"] },
    "revised_offer": { "type": ["object", "string"] },
    "original_score": { "type": ["number", "string"] },
    "revised_score": { "type": ["number", "string"] },
    "savings": { "type": ["object", "string"] },
    "quality_evidence": { "type": ["object", "string"] },
    "review_evidence": { "type": ["object", "string"] },
    "delivery_information": { "type": ["object", "string"] },
    "warranty_information": { "type": ["object", "string"] },
    "payment_terms": { "type": ["object", "string"] },
    "criteria_used": { "type": "array", "items": { "type": "string" } },
    "criteria_missing": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "evidence_urls": { "type": "array", "items": { "type": "string" } },
    "negotiation_history": { "type": "array", "items": { "type": "object" } },
    "status": { "type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "REJECTED", "CHANGES_REQUESTED", "EXPIRED", "CANCELLED", "NOT_CREATED"] },
    "approved_by": { "type": ["string", "null"] },
    "approved_at": { "type": ["string", "null"] },
    "decision_reason": { "type": ["string", "null"] },
    "expires_at": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
