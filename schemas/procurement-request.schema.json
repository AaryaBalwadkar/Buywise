{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "buywise/procurement-request.schema.json",
  "title": "ProcurementRequest",
  "type": "object",
  "required": ["requirement", "currency"],
  "properties": {
    "requirement": { "type": "string", "minLength": 5, "maxLength": 2000 },
    "quantity": { "type": ["integer", "null"], "minimum": 1 },
    "budget": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217, e.g. USD, INR. No conversion without explicit FX source." },
    "delivery_requirement": { "type": ["string", "null"] },
    "mandatory_specs": { "type": "object" },
    "preferred_specs": { "type": "object" },
    "weights": { "type": "object", "description": "Reserved for Phase 2 scoring; stored but not applied in Phase 1." },
    "requested_by": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
